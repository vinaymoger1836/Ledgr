    <!-- Senders seen -->
    <string name="senders_title">Senders seen</string>
    <string name="senders_explainer_title">See who texts you</string>
    <string name="senders_explainer_what">Ledgr will read only the sender name and date of the messages in your SMS inbox, to list which senders (like HDFCBK) are there and how many messages each sent. It never reads message text on this screen.</string>
    <string name="senders_explainer_why">You then tell Ledgr which sender names belong to your banks. Later, only messages from those senders can become transactions; everything else is ignored.</string>
    <string name="senders_explainer_private">Everything stays on this phone. Ledgr has no internet access at all.</string>
    <string name="senders_allow">Allow SMS access</string>
    <string name="senders_skip_hint">You can skip this: type sender headers into an account instead, or import statements.</string>
    <string name="senders_blocked_title">Android didn\'t allow SMS access</string>
    <string name="senders_blocked_body">Phones block SMS access for apps installed outside the Play Store until you allow it once. To turn it on:</string>
    <string name="senders_blocked_step1">1. Tap “Open app info” below.</string>
    <string name="senders_blocked_step2">2. Tap the three-dot menu at the top right and choose “Allow restricted settings”. If you don\'t see it, go on to step 3.</string>
    <string name="senders_blocked_step3">3. Open Permissions, then SMS, and choose Allow.</string>
    <string name="senders_blocked_step4">4. Come back here. This screen refreshes by itself.</string>
    <string name="senders_open_app_info">Open app info</string>
    <string name="senders_try_again">Try again</string>
