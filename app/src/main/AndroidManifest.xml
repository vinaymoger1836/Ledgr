<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Privacy by construction (CLAUDE.md non-negotiable 1, docs/09 §2):
        - No INTERNET permission here, and none may arrive from a library: `./gradlew goldenCheck`
          fails if any merged manifest declares it. Do NOT add tools:node="remove" to hide one.
        - SMS permissions are added in P1/P2, when they are first used.
        - USE_BIOMETRIC is merged in by androidx.biometric.
    -->

    <application
        android:name=".LedgrApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ledgr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
