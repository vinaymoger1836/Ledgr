# Line endings: keep source and golden files LF so byte-for-byte golden compares survive
# Windows autocrlf. Windows batch files stay CRLF.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.md text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
